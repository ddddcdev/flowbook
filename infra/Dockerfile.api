# flowbook API. Build from repo root: docker build -f infra/Dockerfile.api .
#
# Local (flowbook api up): network_mode: host, FLOWBOOK_DATABASE_URL=...@localhost:5432/...
# Cloud (Cloud Run, ECS, Container Apps, etc.): Set FLOWBOOK_DATABASE_URL via env/secrets.
#   Cloud Run sets PORT (default 8080); we use ${PORT:-8000} for local compatibility.
#
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY flowbook ./flowbook

# pkg_resources removed in setuptools 69+; some deps still need it. Pin before install.
RUN pip install --no-cache-dir "setuptools<69"
RUN pip install --no-cache-dir -e ".[full]"

EXPOSE 8000

# PORT from env (Cloud Run etc.); fallback 8000 for local
CMD ["sh", "-c", "uvicorn flowbook.extensions.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
