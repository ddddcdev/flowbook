# Streamlit UI for flowbook. Build from repo root: docker build -f infra/Dockerfile.streamlit .
#
# Local (flowbook streamlit up): network_mode: host, FLOWBOOK_API_URL=http://localhost:8000
# Cloud (Cloud Run, ECS, Container Apps, etc.): Set FLOWBOOK_API_URL via env/secrets.
#   Platform sets PORT (default 8080); we use ${PORT:-8501} for local compatibility.
#
FROM python:3.12-slim

WORKDIR /app

# Copy package and install (build from repo root)
COPY pyproject.toml README.md ./
COPY flowbook ./flowbook

# pkg_resources removed in setuptools 69+; some deps still need it. Pin before install.
RUN pip install --no-cache-dir "setuptools<69"

# flowbook[full] requires pandas>=3, which conflicts with streamlit's pandas<3.
# Two-stage install avoids KeyError: '__version__' during editable build.
RUN pip install --no-cache-dir streamlit requests "altair>=4,<5" openpyxl
RUN pip install --no-cache-dir -e .

EXPOSE 8501

# PORT from env (Cloud Run etc.); fallback 8501 for local
CMD ["sh", "-c", "streamlit run flowbook/extensions/ui/app.py --server.port ${PORT:-8501} --server.address 0.0.0.0"]
