# Copy to .env and adjust. .env is gitignored.
# API uses this to connect to Postgres (optional; if unset, in-memory store is used).
# postgresql+psycopg = SQLAlchemy driver for psycopg3.
FLOWBOOK_DATABASE_URL=postgresql+psycopg://flowbook:flowbook@localhost:5432/flowbook

# Streamlit Docker (flowbook streamlit up --no-env-file): API URL for container
# FLOWBOOK_API_URL=http://localhost:8000

# Logging (optional)
# FLOWBOOK_LOG_LEVEL=INFO
# FLOWBOOK_LOG_FORMAT=json
# FLOWBOOK_LOG_FILE=
# FLOWBOOK_LOG_LOGGER_NAME=flowbook
# FLOWBOOK_LOG_COLOR=1
# FLOWBOOK_LOG_JSON_INDENT=1
